import httpx
import json
from typing import List, Dict, Any, Optional, AsyncGenerator, Union
from app.core.config import settings
import logging

logger = logging.getLogger("ai-copilot")

class LLMProvider:
    def __init__(self):
        self.ollama_url = f"{settings.OLLAMA_BASE_URL}/api/chat"
        self.default_model = settings.DEFAULT_MODEL

    async def generate_chat_response(
        self,
        messages: List[Dict[str, Any]],
        stream: bool = False
    ) -> Union[Dict[str, Any], AsyncGenerator[str, None]]:
        """
        Generate a response using Ollama. Now supports Tool calling and Multimodal input.
        """
        from app.agents.registry import registry
        tools = registry.get_all_metadata()

        # Ollama Multimodal Format: images should be a list of base64 strings
        # inside the message object for some models, or in the 'images' field.
        # For the /api/chat endpoint, the standard is including them in the message content.

        payload = {
            "model": self.default_model,
            "messages": messages,
            "stream": stream,
            "options": {
                "num_predict": 512,
                "temperature": 0.7,
            },
            "tools": tools if tools else None
        }

        if not stream:
            try:
                # Increased timeout for image processing
                async with httpx.AsyncClient(timeout=120.0) as client:
                    logger.info(f"Sending request to Ollama with model {self.default_model}...")
                    response = await client.post(self.ollama_url, json=payload)

                    if response.status_code != 200:
                        logger.error(f"Ollama API Error: {response.status_code} - {response.text}")
                        return {"type": "error", "content": f"Ollama API error: {response.status_code}"}

                    result = response.json().get("message", {})
                    if "tool_calls" in result and result["tool_calls"]:
                        return {"type": "tool_call", "tool_calls": result["tool_calls"]}

                    return {"type": "text", "content": result.get("content", "")}
            except Exception as e:
                logger.exception("Exception during Ollama request")
                return {"type": "error", "content": f"I'm having trouble connecting to my brain: {str(e)}"}
        else:
            return self._stream_response(payload)

    async def _stream_response(self, payload: Dict[str, Any]) -> AsyncGenerator[str, None]:
        try:
            async with httpx.AsyncClient(timeout=120.0) as client:
                async with client.stream("POST", self.ollama_url, json=payload) as response:
                    response.raise_for_status()
                    async for line in response.aiter_lines():
                        if line:
                            chunk = json.loads(line)
                            if "message" in chunk:
                                yield chunk["message"].get("content", "")
                            if chunk.get("done"):
                                break
        except Exception as e:
            logger.error(f"Ollama Stream Error: {e}")
            yield "I'm having trouble connecting to my brain right now."

llm_service = LLMProvider()
